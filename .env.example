# ─────────────────────────────────────────────────────────────
# Knot — environment configuration. Copy to `.env` and fill in.
#   cp .env.example .env
# Never commit your real .env (it's gitignored).
# ─────────────────────────────────────────────────────────────

# ── LLM (Google Gemini by default — free tier) ───────────────
LLM_PROVIDER=gemini                    # gemini | anthropic | openrouter | ollama
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza-xxxxxxxx
# Optional model overrides (defaults shown):
# GEMINI_MODEL=gemini-2.0-flash        # used for fast/chat tiers
# GEMINI_SMART_MODEL=gemini-2.5-flash  # used for the "smart" tier

# Anthropic (only if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# CHAT_MODEL=claude-haiku-4-5-20251001

# OpenRouter (only if LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Ollama (only if LLM_PROVIDER=ollama; needs `ollama serve`)
# OLLAMA_MODEL=llama3.1:8b

# ── App server + mobile API ──────────────────────────────────
PORT=3038
# JWT signing secret for mobile/web login. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetimes in seconds (optional; defaults: access 1h, refresh 30d)
# JWT_ACCESS_TTL=3600
# JWT_REFRESH_TTL=2592000
# CORS allowlist for browser front-ends (comma-separated). Leave unset
# to allow all origins (fine for native mobile apps and local dev).
# CORS_ORIGINS=https://app.example.com,http://localhost:5173

# ── Telegram ─────────────────────────────────────────────────
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=123456:ABC-yourTelegramBotToken
# On Vercel (serverless) the bot MUST use webhooks — long-polling can't run
# on ephemeral functions. Vercel sets VERCEL=1 automatically, which flips the
# bot into webhook mode; locally you can force it with TELEGRAM_MODE=webhook.
# TELEGRAM_MODE=webhook
# Shared secret Telegram echoes back on each webhook POST (X-Telegram-Bot-Api-
# Secret-Token). Set a long random string so the public endpoint can't be spoofed.
# Also required to call POST /telegram/setup. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── Vercel Cron (meeting-briefing sweep) ─────────────────────
# Vercel Cron calls GET /cron/briefing every 5 min (see vercel.json) with
# `Authorization: Bearer $CRON_SECRET`. Set the same value in Vercel.
CRON_SECRET=change-me-to-a-long-random-string

# ── Postgres (settings, drafts, checkpointer) ────────────────
# Serverless needs a HOSTED, pooled Postgres — e.g. Neon (use its pooled
# connection string, host contains "-pooler"). Local dev: `npm run db:local`.
DATABASE_URL=postgresql://knot:knot@localhost:5432/knot?schema=public

# ── Neo4j (knowledge graph) ──────────────────────────────────
# Serverless: use Neo4j Aura (neo4j+s://xxxx.databases.neo4j.io).
# Local Docker: bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me

# ── Public URL (OAuth redirects + Telegram webhook/Mini App) ──
# Your deployment's https base. On Vercel this is your project URL,
# e.g. https://knot-yourname.vercel.app  (no trailing slash).
PUBLIC_URL=https://your-app.vercel.app

# ── Google OAuth (Gmail + Calendar) ──────────────────────────
# Google Cloud Console → Credentials → OAuth client (Web).
# Enable Gmail API + Google Calendar API. Add the redirect URI below.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback

# ── Microsoft OAuth (Outlook) — optional ─────────────────────
# Azure Portal → Microsoft Entra ID → App registrations.
# Delegated scopes: Mail.Read, User.Read, offline_access.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://your-domain.example/auth/microsoft/callback

# ── Localization (optional) ──────────────────────────────────
TZ_DISPLAY=Asia/Kolkata                # timezone for chat date/time answers
DEFAULT_CITY=Delhi                     # default city for the weather tool

# ── Skills system (optional) ─────────────────────────────────
# Directory of user-added external skills. Each subfolder needs a
# skill.manifest.json (validated at boot). See docs/SKILLS.md.
# KNOT_SKILLS_DIR=/path/to/knot-skills
# How long a generic skill approval card waits before expiring (ms).
# SKILL_APPROVAL_TIMEOUT_MS=3600000
